# Copy to /etc/slot-supervisor/env and fill in. See README.md "Settings".
SLOTS_HOST=slots.example.com

# Where the proxy and the health check reach a slot's ports.
SLOTS_UPSTREAM_HOST=localhost

SLOTS_TEMPLATES_DIR=/srv/slots/templates
SLOTS_WORK_DIR=/srv/slots/work
SLOTS_ROUTES_DIR=/etc/caddy/slots

SLOTS_PORT_RANGE=20000-20999
SLOTS_MAX_RUNNING=8
SLOTS_PROXY_RELOAD_COMMAND=caddy reload --config /etc/caddy/Caddyfile

# Needed by `slot serve` only.
SLOTS_LISTEN=localhost:8700
SLOTS_TOKENS_FILE=/etc/slot-supervisor/tokens.json
