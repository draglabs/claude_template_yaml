# Operator env for a claude_template_yaml project. Copy to .env (gitignored), fill the
# PLACEHOLDERs, launch via claude-env (FWADR-032). Strategist owns the values.

# --- Minimum to boot -----------------------------------------------------------

# Machine-safe project slug, e.g. auto-portal.
PROJECT_NAME=PLACEHOLDER

# Subdomain: <sub>.<website>.com in prod, <slot>.<sub>.localhost in dev. e.g. auto
PROJECT_SUB=PLACEHOLDER

# Parent domain, bare, no scheme. e.g. jumpermedia.co
PROJECT_WEBSITE=PLACEHOLDER

# Local port range for dev slots, <low>-<high>, at least 4 ports. e.g. 3080-3089
# Don't guess: `./scripts/port_ledger.sh --propose` prints the lowest free range.
PROJECT_PORTS=PLACEHOLDER

# local-hosted (dev on your machine) or remote-hosted (dev on a shared server).
DEV_ENVIRONMENT_MODE=PLACEHOLDER

# github | gitlab | other — picks the host CLI (gh / glab) and MCP. Ask, never assume.
GIT_HOST=PLACEHOLDER

# dev-main (features → dev → main) or trunk (features → main, released by v* tag).
# Derives INTEGRATION_BRANCH below (FWADR-035). Switching: migration-guide-trunk.md.
GIT_FLOW=PLACEHOLDER

# Self-hosted git host base URL, scheme included, no trailing slash. Unset for *.com.
# GIT_HOST_URL=

# Host PAT with repo read/write; set the one matching GIT_HOST (FWADR-030).
# GitHub Enterprise uses GH_ENTERPRISE_TOKEN instead of GH_TOKEN.
# GH_TOKEN=
# GITLAB_TOKEN=

# Subdirectory holding the primary code repo; matches the repo slug (FWADR-021).
# Multi-repo projects override per W-item via `target-repo:` frontmatter.
DEFAULT_CODE_SUBDIR=PLACEHOLDER

# --- Optional ------------------------------------------------------------------

# Path to the canonical template repo. Unset → sibling-directory search.
# CLAUDE_TEMPLATE_ROOT=

# Terminal app for scripts/spawn_worker.sh: iterm (default) or terminal (FWADR-031).
# WORKER_TERMINAL=iterm

# Researcher role only (FWADR-024): the one dir under $CODE_ROOT it may modify.
# RESEARCHER_SCOPE_DIR=

# Researcher role only: comma-separated data files outside the scope dir it may edit.
# RESEARCHER_DATA_CARVEOUTS=

# Paperclip board, when the roles run as FW_* agents (FWADR-040). URL without /api.
# PAPERCLIP_API_URL=

# Board API key for scripts/paperclip_company.py; the sync hook's pin check needs it.
# PAPERCLIP_API_KEY=

# Paperclip company name. Unset → PROJECT_NAME.
# PAPERCLIP_COMPANY=

# Planning repo the agents read CLAUDE.md and the exceptions file from, as owner/repo.
# PAPERCLIP_PLANNING_REPO=

# Existing agent whose adapter and environment new FW_* agents copy. Unset → Lead.
# PAPERCLIP_TEMPLATE_AGENT=

# App runtime secrets (DATABASE_URL, API keys) do NOT go here — they live in
# $PROJECT_DIR/$DEFAULT_CODE_SUBDIR/.env (FWADR-033).

# --- Derived — runs when this file is sourced ----------------------------------

# INTEGRATION_BRANCH: main under trunk, dev otherwise. Set GIT_FLOW, never this.
case "$GIT_FLOW" in
  trunk) export INTEGRATION_BRANCH=main ;;
  *)     export INTEGRATION_BRANCH=dev ;;
esac

# Git auth auto-wire (FWADR-030): routes HTTPS git to the host CLI's credential
# helper for this shell only; no gitconfig is written. Needs HTTPS remotes.
case "$GIT_HOST" in
  github)
    _host="${GIT_HOST_URL:-https://github.com}"
    [ -n "$GIT_HOST_URL" ] && export GH_HOST="${GIT_HOST_URL#http*://}"
    export GIT_CONFIG_COUNT=1 \
           GIT_CONFIG_KEY_0="credential.${_host}.helper" \
           GIT_CONFIG_VALUE_0='!gh auth git-credential'
    unset _host ;;
  gitlab)
    _host="${GIT_HOST_URL:-https://gitlab.com}"
    [ -n "$GIT_HOST_URL" ] && export GITLAB_HOST="${GIT_HOST_URL#http*://}"
    export GIT_CONFIG_COUNT=1 \
           GIT_CONFIG_KEY_0="credential.${_host}.helper" \
           GIT_CONFIG_VALUE_0='!glab auth git-credential'
    unset _host ;;
esac
