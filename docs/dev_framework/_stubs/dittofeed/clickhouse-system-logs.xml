<!--
  ClickHouse system-log hygiene for a Dittofeed stack (FWADR-038).
  Copy into the stack's deploy dir and bind-mount this FILE by name into
  /etc/clickhouse-server/config.d/ — never the whole directory.
  On a running stack: TRUNCATE TABLE system.text_log first, then recreate.
-->
<clickhouse>
    <!-- The bloat source: stock level is trace with no TTL. -->
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>

    <!-- 1 s samplers: a week is plenty. -->
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_metric_log>
    <trace_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </trace_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </processors_profile_log>

    <!-- What ran, failed and merged: a month for runbook queries. -->
    <query_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </query_views_log>
    <part_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </part_log>
    <error_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </error_log>
</clickhouse>
